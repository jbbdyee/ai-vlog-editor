{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memo.schema.json",
  "title": "Memo semantic selection annotation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "annotations"],
  "properties": {
    "source": {"$ref": "common.schema.json"},
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memo_id", "memo_interval", "temporal_reference", "expected_outcome", "acceptable_proposal_ids", "target_intervals", "rationale_code", "ambiguity"],
        "properties": {
          "memo_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
          "memo_interval": {"$ref": "common.schema.json#/$defs/interval"},
          "temporal_reference": {"enum": ["JUST_NOW", "EARLIER", "UNKNOWN"]},
          "expected_outcome": {"enum": ["SELECTED", "AMBIGUOUS", "NO_MATCH", "INSUFFICIENT_EVIDENCE"]},
          "acceptable_proposal_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/opaque_id"}},
          "preferred_proposal_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
          "proposal_manifest_fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "target_intervals": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/interval"}},
          "rationale_code": {"type": "string", "minLength": 1},
          "ambiguity": {"$ref": "common.schema.json#/$defs/ambiguity"}
        },
        "allOf": [
          {"if": {"properties": {"expected_outcome": {"const": "SELECTED"}}}, "then": {"properties": {"acceptable_proposal_ids": {"minItems": 1}}, "required": ["proposal_manifest_fingerprint"]}},
          {"if": {"properties": {"expected_outcome": {"enum": ["AMBIGUOUS", "NO_MATCH", "INSUFFICIENT_EVIDENCE"]}}}, "then": {"properties": {"acceptable_proposal_ids": {"maxItems": 0}}}}
        ]
      }
    }
  },
  "examples": [{"annotations": [{"memo_id": "EXAMPLE-MEMO", "memo_interval": {"start_seconds": 8.0, "end_seconds": 9.0}, "temporal_reference": "JUST_NOW", "expected_outcome": "AMBIGUOUS", "acceptable_proposal_ids": [], "target_intervals": [], "rationale_code": "EXAMPLE_REFERENCE_UNCLEAR", "ambiguity": "INSUFFICIENT_CONTEXT"}]}]
}
