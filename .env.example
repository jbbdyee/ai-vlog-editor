OPENAI_API_KEY=
GEMINI_API_KEY=
# TODO 26: 대화형 편집 두뇌(Claude). 키가 없으면 로컬 AI만 씀. 모델 기본값 claude-haiku-5-5
ANTHROPIC_API_KEY=
CUTORY_CLAUDE_MODEL=claude-haiku-5-5
CUTORY_SEMANTIC_TEXT_MODEL=gpt-6-luna
CUTORY_SEMANTIC_TEXT_MODEL=gpt-6-luna

# Local PostgreSQL development settings.
# Copy this file to .env and replace the password before starting PostgreSQL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cutory
POSTGRES_USER=cutory
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional n8n render follow-up (disabled when both are empty). Loopback URL only; no token in the URL.
# The token is sent as "Authorization: Bearer ..." and must match the n8n Header Auth credential (>= 32 chars).
CUTORY_N8N_WEBHOOK_URL=
CUTORY_N8N_WEBHOOK_TOKEN=
# Optional delivery trace (JSON Lines, no secrets). Default: temporary/render-events/deliveries.jsonl
CUTORY_RENDER_EVENT_LOG=
